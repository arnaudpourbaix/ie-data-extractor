BACKUP ~weidu_external/backup/extract~
AUTHOR "Aigleborgne"
VERSION ~1.0~

ALWAYS
    INCLUDE "%MOD_FOLDER%/common.tpa"
END

BEGIN ~extract creatures~
NO_LOG_RECORD
DESIGNATED 1
COPY ~extract/blank~ ~extract/csv/source.csv~

APPEND_OUTER ~extract/csv/source.csv~ ~file;general;race;class;anim;deathvar;dialog;level;gender;sex;allegiance;overrideScript;classScript;raceScript;generalScript;defaultScript;helmet;shield;lring;rring;amulet;weapon1;weapon2;weapon3;weapon4;xpv;hp;thac0;apr;str;name~
COPY_EXISTING_REGEXP GLOB ~^.+\.cre$~ ~override~
    PATCH_IF (%SOURCE_SIZE% > 0x2d3) BEGIN
        READ_LONG 0x14 xpv
        READ_BYTE 0x271 g
        READ_BYTE 0x272 r
        READ_BYTE 0x273 c
        READ_LONG 0x28 a
        READ_BYTE 0x234 level
        READ_BYTE 0x237 rawSex
        READ_BYTE 0x275 rawGender
        READ_BYTE 0x270 rawAllegiance
        READ_ASCII 0x280 deathvar (32) NULL
        READ_ASCII 0x2cc dialog
        READ_STRREF 0x08 name
        READ_ASCII 0x248 overrideScript
        READ_ASCII 0x250 classScript
        READ_ASCII 0x258 raceScript
        READ_ASCII 0x260 generalScript
        READ_ASCII 0x268 defaultScript
        READ_SHORT 0x26 hp
        READ_BYTE 0x52 thac0
        READ_BYTE 0x53 apr
        READ_BYTE 0x238 str
        READ_BYTE 0x239 strEx
        LOOKUP_IDS_SYMBOL_OF_INT general "general" %g%
        LOOKUP_IDS_SYMBOL_OF_INT race "race" %r%
        LOOKUP_IDS_SYMBOL_OF_INT class "class" %c%
        LOOKUP_IDS_SYMBOL_OF_INT anim "animate" %a%
        LOOKUP_IDS_SYMBOL_OF_INT sex "gender" %rawSex%
        LOOKUP_IDS_SYMBOL_OF_INT gender "gender" %rawGender%
        LOOKUP_IDS_SYMBOL_OF_INT allegiance "ea" %rawAllegiance%
        LPF GET_CRE_ITEM_IN_SLOT
            INT_VAR
                slot = 0
            RET
                helmet = item
        END
        LPF GET_CRE_ITEM_IN_SLOT
            INT_VAR
                slot = 2
            RET
                shield = item
        END
        LPF GET_CRE_ITEM_IN_SLOT
            INT_VAR
                slot = 4
            RET
                lring = item
        END
        LPF GET_CRE_ITEM_IN_SLOT
            INT_VAR
                slot = 5
            RET
                rring = item
        END
        LPF GET_CRE_ITEM_IN_SLOT
            INT_VAR
                slot = 6
            RET
                amulet = item
        END
        LPF GET_CRE_ITEM_IN_SLOT
            INT_VAR
                slot = 9
            RET
                weapon1 = item
        END
        LPF GET_CRE_ITEM_IN_SLOT
            INT_VAR
                slot = 10
            RET
                weapon2 = item
        END
        LPF GET_CRE_ITEM_IN_SLOT
            INT_VAR
                slot = 11
            RET
                weapon3 = item
        END
        LPF GET_CRE_ITEM_IN_SLOT
            INT_VAR
                slot = 12
            RET
                weapon4 = item
        END
        PATCH_IF NOT "%overrideScript%" STRING_EQUAL_CASE none
            AND NOT "%overrideScript%" STRING_EQUAL_CASE ""
            AND NOT FILE_EXISTS_IN_GAME ~%overrideScript%.bcs~
        THEN BEGIN
            PATCH_PRINT ~Missing script "%overrideScript%"~
            SPRINT overrideScript ""
        END
        PATCH_IF NOT "%classScript%" STRING_EQUAL_CASE none
            AND NOT "%classScript%" STRING_EQUAL_CASE ""
            AND NOT FILE_EXISTS_IN_GAME ~%classScript%.bcs~
        THEN BEGIN
            PATCH_PRINT ~Missing script "%classScript%"~
            SPRINT classScript ""
        END
        PATCH_IF NOT "%raceScript%" STRING_EQUAL_CASE none
            AND NOT "%raceScript%" STRING_EQUAL_CASE ""
            AND NOT FILE_EXISTS_IN_GAME ~%raceScript%.bcs~
        THEN BEGIN
            PATCH_PRINT ~Missing script "%raceScript%"~
            SPRINT raceScript ""
        END
        PATCH_IF NOT "%generalScript%" STRING_EQUAL_CASE none
            AND NOT "%generalScript%" STRING_EQUAL_CASE ""
            AND NOT FILE_EXISTS_IN_GAME ~%generalScript%.bcs~
        THEN BEGIN
            PATCH_PRINT ~Missing script "%generalScript%"~
            SPRINT generalScript ""
        END
        PATCH_IF NOT "%defaultScript%" STRING_EQUAL_CASE none
            AND NOT "%defaultScript%" STRING_EQUAL_CASE ""
            AND NOT FILE_EXISTS_IN_GAME ~%defaultScript%.bcs~
        THEN BEGIN
            PATCH_PRINT ~Missing script "%defaultScript%"~
            SPRINT defaultScript ""
        END
        SPRINT strength "%str%"
        PATCH_IF str = 18 BEGIN
            SPRINT strength "%str%/%strEx%"
        END
        INNER_ACTION BEGIN
            APPEND_OUTER ~extract/csv/source.csv~ ~%SOURCE_RES%;%general%;%race%;%class%;%anim%;%deathvar%;%dialog%;%level%;%gender%;%sex%;%allegiance%;%overrideScript%;%classScript%;%raceScript%;%generalScript%;%defaultScript%;%helmet%;%shield%;%lring%;%rring%;%amulet%;%weapon1%;%weapon2%;%weapon3%;%weapon4%;%xpv%;%hp%;%thac0%;%apr%;%strength%;%name%~
        END
    END
BUT_ONLY

BEGIN ~extract items~
NO_LOG_RECORD
DESIGNATED 2
COPY ~extract/blank~ ~extract/csv/items.csv~
COPY_EXISTING_REGEXP GLOB ~^.+\.itm$~ ~override~
    PATCH_IF (BUFFER_LENGTH >= 0x72) BEGIN  // sanity check
        READ_LONG 0x0c strref
        PATCH_IF ((strref > 0) AND (strref < 200000)) BEGIN
            READ_STRREF 0x0c name
        END ELSE BEGIN
            READ_STRREF 0x08 name
        END
        PATCH_IF ("%version%" STRING_COMPARE_CASE "V1.1" = 0) BEGIN  // pst, itm v1.1
            SET min_size = 0x9a
        END ELSE BEGIN
            SET min_size = 0x72
        END
        READ_LONG 0x6a fx_off ELSE 0
        SET counter_offset = 0x70
        SET abil_length = 0x38
        SET fx_type = 0
        READ_LONG 0x64 abil_off ELSE 0
        READ_SHORT 0x68 abil_num ELSE 0
        FOR (index = (0 - 1); index < abil_num; ++index) BEGIN  // we start at -1 for global effects
            PATCH_IF (index < 0) BEGIN  // if loop through globals needed
                SET abil_fx_idx = 0  // start with effect 0 since we're in the global loop
                SET abil_type = "-1"  // basically, ignore header type checks for global loop
            END ELSE BEGIN  // otherwise normal ability

                READ_SHORT (abil_off + (abil_length * index)) abil_type
                SET counter_offset = (abil_off + 0x1e + (abil_length * index))
                READ_SHORT (abil_off + 0x20 + (abil_length * index)) abil_fx_idx
            END
            READ_SHORT counter_offset counter  // fx_num on global loop, otherwise abil_fx_num
            SET last = 0  // and only on the right # header, if specified
            FOR (index2 = 0; index2 < (counter - last); ++index2) BEGIN
                // read the variables from the current effect
                READ_SHORT (fx_off + (0x08 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) o_opcode
                READ_BYTE (fx_off + 0x02 + (0x0a * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) o_target
                READ_BYTE (fx_off + 0x03 + (0x0d * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) o_power
                READ_LONG (fx_off + 0x04 + (0x10 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) o_parameter1
                READ_LONG (fx_off + 0x08 + (0x10 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) o_parameter2
                READ_BYTE (fx_off + 0x0c + (0x10 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) o_timing
                READ_BYTE (fx_off + 0x0d + (0x47 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) o_resist_dispel
                READ_LONG (fx_off + 0x0e + (0x12 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) o_duration
                READ_BYTE (fx_off + 0x12 + (0x12 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) o_probability1
                READ_BYTE (fx_off + 0x13 + (0x13 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) o_probability2
                READ_ASCII (fx_off + 0x14 + (0x14 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) o_resource
                READ_LONG (fx_off + 0x1c + (0x14 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) o_dicenumber
                READ_LONG (fx_off + 0x20 + (0x14 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) o_dicesize
                READ_LONG (fx_off + 0x24 + (0x14 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) o_savingthrow
                READ_LONG (fx_off + 0x28 + (0x14 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) o_savebonus
                READ_LONG (fx_off + 0x2c + (0x14 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) o_special
                PATCH_IF (o_opcode = 287) BEGIN
                    INNER_ACTION BEGIN
                        APPEND_OUTER ~extract/csv/items.csv~ ~%SOURCE_FILE%;%o_opcode%;%o_parameter1%;%o_parameter2%;%o_resource%;%name%~
                    END
                END
            END
            // end of the for loop through effects
        END
        // end loop through effects on ability
    END
    // end ability loop
BUT_ONLY

BEGIN ~extract spells~
NO_LOG_RECORD
DESIGNATED 3
COPY ~extract/blank~ ~extract/csv/spells_source.csv~

APPEND_OUTER ~extract/csv/spells_source.csv~ ~file;level;type;ids;name~
COPY_EXISTING_REGEXP GLOB ~sp\(in\|cl\|pr\|wi\)[0-9][0-9][0-9]\.spl~ ~override~
    PATCH_IF ("%version%" STRING_COMPARE_CASE "V2.0" = 0) BEGIN  // iwd2, spl 2.0
        SET min_size = 0x82
    END ELSE BEGIN
        SET min_size = 0x72
    END
    READ_LONG 0x6a fx_off ELSE 0
    SET counter_offset = 0x70
    SET abil_length = 0x28
    SET fx_type = 0
    READ_LONG 0x64 abil_off ELSE 0
    READ_SHORT 0x68 abil_num ELSE 0
    PATCH_IF (BUFFER_LENGTH >= min_size) BEGIN  // sanity check
        READ_STRREF 0x08 name
        PATCH_IF ("%name%" STRING_COMPARE_CASE "<Invalid Strref -1>") = 0 BEGIN
            SPRINT name ""
        END
        READ_LONG 0x34 level
        READ_SHORT 0x1c t
        PATCH_IF (t = 0) BEGIN
            SPRINT type ~Special~
        END ELSE PATCH_IF (t = 1) BEGIN
            SPRINT type ~Wizard~
        END ELSE PATCH_IF (t = 2) BEGIN
            SPRINT type ~Priest~
        END ELSE PATCH_IF (t = 3) BEGIN
            SPRINT type ~Psionic~
        END ELSE PATCH_IF (t = 4) BEGIN
            SPRINT type ~Innate~
        END ELSE PATCH_IF (t = 5) BEGIN
            SPRINT type ~Bard Song~
        END ELSE BEGIN
            SPRINT type ~Unknown~
        END
        LPF NAME_NUM_OF_SPELL_RES
            STR_VAR
                spell_res = EVALUATE_BUFFER "%SOURCE_RES%"
            RET
                ids = spell_name
        END
        PATCH_IF (~%ids%~ STRING_MATCHES_REGEXP ~^-?[0-9]+$~ = 0) BEGIN
            SPRINT ids ~~
        END
        INNER_ACTION BEGIN
            APPEND_OUTER ~extract/csv/spells_source.csv~ ~%SOURCE_RES%;%level%;%type%;%ids%;%name%~
        END
    END
BUT_ONLY

BEGIN ~check spells~
NO_LOG_RECORD
DESIGNATED 4
COPY ~extract/blank~ ~extract/csv/spells_check.csv~
COPY_EXISTING_REGEXP GLOB ~sp\(in\|cl\|pr\|wi\)[0-9][0-9][0-9]\.spl~ ~override~
    // COPY_EXISTING_REGEXP GLOB ~spwi943.spl~ ~override~
    PATCH_IF ("%version%" STRING_COMPARE_CASE "V2.0" = 0) BEGIN  // iwd2, spl 2.0
        SET min_size = 0x82
    END ELSE BEGIN
        SET min_size = 0x72
    END
    READ_LONG 0x6a fx_off ELSE 0
    SET counter_offset = 0x70
    SET abil_length = 0x28
    SET fx_type = 0
    READ_LONG 0x64 abil_off ELSE 0
    READ_SHORT 0x68 abil_num ELSE 0
    PATCH_IF (BUFFER_LENGTH >= min_size) BEGIN  // sanity check
        READ_LONG 0x0c strref
        PATCH_IF ((strref > 0) AND (strref < 200000)) BEGIN
            READ_STRREF 0x0c name
        END ELSE BEGIN
            READ_STRREF 0x08 name
        END
        PATCH_IF ("%name%" STRING_COMPARE_CASE "<Invalid Strref -1>") = 0 BEGIN
            SPRINT name ""
        END
        SET bypassResistance = 1
        FOR (index = "-1"; index < abil_num; ++index) BEGIN  // we start at -1 for global effects
            PATCH_IF (index < 0) BEGIN  // if loop through globals needed
                SET abil_fx_idx = 0  // start with effect 0 since we're in the global loop
                SET abil_type = "-1"  // basically, ignore header type checks for global loop
            END ELSE BEGIN  // otherwise normal ability

                READ_BYTE (abil_off + (abil_length * index)) abil_type
                SET counter_offset = (abil_off + 0x1e + (abil_length * index))
                READ_SHORT (abil_off + 0x20 + (abil_length * index)) abil_fx_idx
            END
            READ_SHORT counter_offset counter  // fx_num on global loop, otherwise abil_fx_num
            FOR (index2 = 0; index2 < counter; ++index2) BEGIN
                READ_SHORT (fx_off + (0x08 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) o_opcode
                READ_LONG (fx_off + 0x04 + (0x10 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) o_parameter1
                READ_LONG (fx_off + 0x08 + (0x10 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) o_parameter2
                READ_BYTE (fx_off + 0x0d + (0x10 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) o_dispel
                READ_ASCII (fx_off + 0x14 + (0x10 * fx_type) + ((abil_fx_idx + index2) * (0x30 + (0xd8 * fx_type)))) o_resource
                // PATCH_PRINT ~%SOURCE_FILE% opcode %o_opcode% dispel:%o_dispel%~
                PATCH_IF bypassResistance = 1 AND o_dispel = 1 BEGIN
                    bypassResistance = 0
                END
                // PATCH_IF o_opcode = 324 BEGIN
                // INNER_ACTION BEGIN
                // APPEND_OUTER ~extract/csv/spells_check.csv~ ~%SOURCE_FILE%;%o_parameter1%;%o_parameter2%;%o_resource%;%o_dispel%;%name%~
                // END
                // END
            END
            // end of the for loop through effects
        END
        // end loop through effects on ability
        PATCH_IF bypassResistance = 1 BEGIN
            INNER_ACTION BEGIN
                APPEND_OUTER ~extract/csv/spells_check.csv~ ~%SOURCE_FILE%;%name%~
            END
        END
    END
BUT_ONLY_IF_IT_CHANGES

BEGIN ~Dead magic areas~
NO_LOG_RECORD
DESIGNATED 4
COPY_EXISTING_REGEXP GLOB ~^.+\.are$~ ~override~
    READ_LONG 0x14 flags
    PATCH_IF (flags BAND 4) BEGIN
        PATCH_PRINT ~Dead magic: %SOURCE_RES%~
        // or append an !AreaCheck("%SOURCE_RES%") line to a .baf you compile afterward
    END
BUT_ONLY
